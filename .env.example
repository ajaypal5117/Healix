# Copy to .env and fill in. .env is git-ignored.

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Vector store: "faiss" (local, default) or "pinecone" (managed) ---
VECTOR_BACKEND=faiss
FAISS_INDEX_DIR=artifacts/faiss_index

# Only needed when VECTOR_BACKEND=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=healix
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Corpus and chunking ---
DATA_DIR=data
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Retrieval and generation ---
TOP_K=4
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=320

# --- Server ---
HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=0
MAX_QUESTION_CHARS=500
