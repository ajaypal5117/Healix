# Required for generation only. Indexing, retrieval and the benchmark all run
# without it.
OPENAI_API_KEY=

# --- Embeddings ---
# minilm  = sentence-transformers/all-MiniLM-L6-v2, 384-dim. The default.
# hashing = deterministic numpy fallback, same 384 dimensions, far worse
#           retrieval. Use only where torch has no wheel.
EMBEDDING_BACKEND=minilm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64

# --- Corpus and chunking ---
# Changing these invalidates a built index; the loader refuses to open a
# mismatched one rather than returning nonsense.
DATA_DIR=data
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Index and retrieval ---
INDEX_DIR=artifacts/index
TOP_K=4

# --- Generation ---
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=320

# --- Server ---
HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=0
